{
  "name": "eaoin",
  "version": "1.0.0",
  "description": "EAOIN Release 1.0 End Game Update — playable voxel sandbox with BabylonJS WebGPU, native Vulkan pipeline scaffolding, cinematic credits, city economy, multiplayer replication, marketplace, modding SDK, and advanced physics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "server": "tsx server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "docs": "tsc && node scripts/generate-docs.js",
    "native:vulkan:check": "node scripts/check-native-vulkan.mjs",
    "native:vulkan:install-deps": "bash scripts/install-native-vulkan-deps.sh",
    "native:vulkan:configure": "cmake -S native/vulkan -B native/vulkan/build",
    "native:vulkan:build": "cmake --build native/vulkan/build --config Release",
    "native:vulkan:run": "./native/vulkan/build/eaoin-vulkan-bootstrap",
    "native:vulkan:docker-build": "docker build -t eaoin-vulkan native/vulkan",
    "native:vulkan:docker-run": "docker run --rm -v \"$PWD\":/workspace/EAOIN eaoin-vulkan"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/loaders": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "voxel",
    "sandbox",
    "rpg",
    "eaoin",
    "minecraft-style"
  ],
  "author": "EAOIN Engine Team",
  "license": "MIT"
}
