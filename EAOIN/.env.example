# ------------------------------------------------------------------
# EAOIN environment template. Copy to `.env` and fill in.
# NEVER commit a real .env — PAYPAL_CLIENT_SECRET is a live credential.
# ------------------------------------------------------------------

# --- Client (Vite; these are compiled into the browser bundle) ---
# Set this to enable real PayPal checkout. Leave unset for sandbox coins.
VITE_PAYMENTS_BASE_URL=/api/payments

# --- Server (never reaches the browser) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PUBLIC_ORIGIN=http://localhost:3000
PAYPAL_RETURN_URL=http://localhost:3000/checkout/return
PAYPAL_CANCEL_URL=http://localhost:3000/checkout/cancel
PAYPAL_BRAND_NAME=EAOIN
