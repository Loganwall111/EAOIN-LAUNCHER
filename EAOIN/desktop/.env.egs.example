# ==============================================================================
# EAOIN · Epic Games Store (EGS) deployment credentials
# ==============================================================================
#
# Copy this file to `.env.egs` (same folder) and fill in your real values.
# NEVER commit `.env.egs` — it is git-ignored. These are the cloud-sandbox
# credentials you generate on the Epic Dev Portal under your Product's
# "Sandboxes" settings.
#
#   https://dev.epicgames.com/portal/
#
# How to use: deploy-egs.js reads these either as real environment variables or
# via Node's --env-file loader:
#
#   npm run deploy:egs                    # dry-run (prints the command)
#   npm run deploy:egs -- --run           # execute Build Patch Tool
#   node --env-file=.env.egs scripts/deploy-egs.js --run
#
# The Build Patch Tool (BPT) executable directory. On Windows it usually
# installs under C:\Program Files\Epic Games\BuildPatchTool. Set EPIC_BPT_DIR
# if it isn't on one of the default search paths.
# ------------------------------------------------------------------------------
#EPIC_BPT_DIR=C:\Program Files\Epic Games\BuildPatchTool

# Your Epic Organization ID (found on the Organization settings page).
#ORGANIZATION_ID=your_org_id_here

# Your Product ID (the numeric Product id on the Epic Dev Portal).
#PRODUCT_ID=your_product_id_here

# The Artifact you're pushing to (sandbox -> artifact). This is the ID from the
# "Artifacts" tab of the EGS CloudSandbox for your product.
#ARTIFACT_ID=your_artifact_id_here

# OAuth client ID + secret used by Build Patch Tool to authenticate uploads.
# Generate these in the Epic Dev Portal under your Sandbox's "Build Patch Tool"
# integration.
#CLIENT_ID=your_client_id_here
#CLIENT_SECRET=your_client_secret_here

# Optional: override the version string stamped into the build (defaults to the
# version in desktop/package.json).
#EGS_VERSION=2.0.0
